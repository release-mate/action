#!/usr/bin/env bash
# bin/setup — install developer tooling for release-mate.
# Idempotent: re-running skips tools already on PATH.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT

log() { printf '==> %s\n' "$*"; }
err() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

detect_os() {
  case "$(uname -s)" in
    Darwin) echo "macos" ;;
    Linux)  echo "linux" ;;
    *)      err "unsupported OS: $(uname -s)" ;;
  esac
}

install_brew_pkg() {
  local pkg="$1"
  if have "$pkg"; then
    log "$pkg already installed"
    return
  fi
  if ! have brew; then
    err "Homebrew not found. Install from https://brew.sh, then re-run."
  fi
  log "installing $pkg via Homebrew"
  brew install "$pkg"
}

readonly LEFTHOOK_VERSION="v2.1.6"

install_linux_lefthook() {
  if have lefthook; then
    log "lefthook already installed"
    return
  fi
  if have go; then
    log "installing lefthook ${LEFTHOOK_VERSION} via go install"
    go install "github.com/evilmartians/lefthook@${LEFTHOOK_VERSION}"
    return
  fi
  err "lefthook not found and Go is unavailable. Install a release from https://github.com/evilmartians/lefthook/releases"
}

install_linux_actionlint() {
  if have actionlint; then
    log "actionlint already installed"
    return
  fi
  local bindir="${HOME}/.local/bin"
  mkdir -p "$bindir"
  log "installing actionlint to $bindir"
  local script
  script="$(mktemp)"
  curl -fsSL -o "$script" \
    https://raw.githubusercontent.com/rhysd/actionlint/main/scripts/download-actionlint.bash
  bash "$script" latest "$bindir"
  rm -f "$script"
  case ":$PATH:" in
    *":$bindir:"*) : ;;
    *) log "note: add $bindir to PATH to use actionlint" ;;
  esac
}

install_linux_gitleaks() {
  if have gitleaks; then
    log "gitleaks already installed"
    return
  fi
  local arch
  case "$(uname -m)" in
    x86_64|amd64)  arch="x64" ;;
    arm64|aarch64) arch="arm64" ;;
    *)             err "unsupported arch for gitleaks binary: $(uname -m)" ;;
  esac
  install_github_release_binary gitleaks/gitleaks gitleaks "linux_${arch}"
}

install_linux_shellcheck() {
  if have shellcheck; then
    log "shellcheck already installed"
    return
  fi
  if have apt-get; then
    log "installing shellcheck via apt-get"
    sudo apt-get install -y shellcheck
    return
  fi
  if have dnf; then
    log "installing shellcheck via dnf"
    sudo dnf install -y ShellCheck
    return
  fi
  if have pacman; then
    log "installing shellcheck via pacman"
    sudo pacman -S --noconfirm shellcheck
    return
  fi
  err "shellcheck not found. Install via your package manager (apt-get install shellcheck, dnf install ShellCheck, etc)."
}

install_check_jsonschema() {
  if have check-jsonschema; then
    log "check-jsonschema already installed"
    return
  fi
  if [ "$(uname -s)" = "Darwin" ] && have brew; then
    log "installing check-jsonschema via Homebrew"
    brew install check-jsonschema
    return
  fi
  if have pipx; then
    log "installing check-jsonschema via pipx"
    pipx install check-jsonschema
    return
  fi
  if have pip3; then
    log "installing check-jsonschema via pip3 --user"
    pip3 install --user check-jsonschema
    return
  fi
  err "check-jsonschema not found. Install pipx (recommended) or pip3, then re-run."
}

install_mado() {
  if have mado; then
    log "mado already installed"
    return
  fi
  if have brew; then
    log "installing mado via brew tap"
    brew tap akiomik/mado https://github.com/akiomik/mado.git
    brew install mado
    return
  fi
  if have cargo; then
    log "installing mado via cargo"
    cargo install mado
    return
  fi
  err "mado not found. Install Homebrew, or Rust+cargo, then re-run. Releases: https://github.com/akiomik/mado/releases"
}

install_committed() {
  if have committed; then
    log "committed already installed"
    return
  fi

  if have brew; then
    log "installing committed via Homebrew"
    brew install committed
    return
  fi

  local os arch
  case "$(uname -s)" in
    Darwin) os="apple-darwin" ;;
    Linux)  os="unknown-linux-musl" ;;
    *)      os="" ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  arch="x86_64" ;;
    arm64|aarch64) arch="aarch64" ;;
    *)             arch="" ;;
  esac

  if [ -n "$os" ] && [ -n "$arch" ]; then
    install_github_release_binary crate-ci/committed committed "${arch}-${os}"
    return
  fi

  if have cargo; then
    log "installing committed via cargo"
    cargo install committed
    return
  fi

  err "committed not found and no prebuilt binary for $(uname -s)/$(uname -m). Install Homebrew, or Rust+cargo, then re-run. Releases: https://github.com/crate-ci/committed/releases"
}

sha256_of() {
  if have shasum; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif have sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  else
    err "no sha256 utility (shasum or sha256sum) available"
  fi
}

# Install a binary from the latest GitHub release of $1 (owner/name).
# $2 is the binary name (also used to locate it inside the archive).
# $3 is a substring filter matched against `.tar.gz` asset names.
# Verifies SHA256 against the API-published asset digest before installing.
install_github_release_binary() {
  local repo="$1" binary_name="$2" filter="$3"
  local bindir tmpdir asset_url digest expected_sha256 actual_sha256 binary

  have python3 || err "python3 required to verify ${binary_name} download. Install python3, or grab a binary from https://github.com/${repo}/releases"

  bindir="${HOME}/.local/bin"
  mkdir -p "$bindir"

  log "resolving ${binary_name} release for ${filter}"
  { read -r asset_url; read -r digest; } < <(
    curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" \
      | python3 -c '
import json, sys
target = sys.argv[1]
data = json.load(sys.stdin)
for asset in data.get("assets", []):
    if target in asset["name"] and asset["name"].endswith(".tar.gz"):
        print(asset["browser_download_url"])
        print(asset.get("digest", ""))
        break
' "$filter"
  )

  [ -n "$asset_url" ] || err "no ${binary_name} release asset matching '${filter}'. Releases: https://github.com/${repo}/releases"
  [ -n "$digest" ] || err "no digest published for ${binary_name} asset; refusing to install unverified binary"

  expected_sha256="${digest#sha256:}"
  [ "$digest" != "$expected_sha256" ] || err "unexpected digest format from GitHub API: $digest"

  tmpdir="$(mktemp -d)"

  log "downloading $asset_url"
  curl -fsSL -o "${tmpdir}/archive.tar.gz" "$asset_url"

  actual_sha256="$(sha256_of "${tmpdir}/archive.tar.gz")"
  if [ "$actual_sha256" != "$expected_sha256" ]; then
    rm -rf "$tmpdir"
    err "sha256 mismatch: expected ${expected_sha256}, got ${actual_sha256}"
  fi
  log "sha256 verified"

  tar -xzf "${tmpdir}/archive.tar.gz" -C "$tmpdir"

  binary="$(find "$tmpdir" -type f -name "$binary_name" -perm -u+x | head -1)"
  if [ -z "$binary" ]; then
    rm -rf "$tmpdir"
    err "${binary_name} binary not found in archive"
  fi

  install -m 0755 "$binary" "${bindir}/${binary_name}"
  rm -rf "$tmpdir"
  log "installed ${binary_name} to ${bindir}/${binary_name}"

  case ":$PATH:" in
    *":$bindir:"*) : ;;
    *) log "note: add $bindir to PATH to use ${binary_name}" ;;
  esac
}

main() {
  cd "$REPO_ROOT"

  local os
  os="$(detect_os)"

  case "$os" in
    macos)
      install_brew_pkg lefthook
      install_brew_pkg actionlint
      install_brew_pkg gitleaks
      install_brew_pkg shellcheck
      ;;
    linux)
      install_linux_lefthook
      install_linux_actionlint
      install_linux_gitleaks
      install_linux_shellcheck
      ;;
  esac

  install_mado
  install_committed
  install_check_jsonschema

  log "wiring git hooks"
  lefthook install

  log "done"
}

main "$@"
