#!/usr/bin/env bash
# bin/setup — install developer tooling for release-mate.
# Idempotent: re-running skips tools already on PATH.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
readonly SHASUMS_FILE="${REPO_ROOT}/bin/setup.shasums"

log() { printf '==> %s\n' "$*"; }
err() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

readonly ACTIONLINT_VERSION="v1.7.12"
readonly COMMITTED_VERSION="v1.1.11"
readonly GITLEAKS_VERSION="v8.30.1"
readonly LEFTHOOK_VERSION="v2.1.9"
readonly MADO_VERSION="v0.3.0"
readonly SHELLCHECK_VERSION="v0.11.0"

sha256_of() {
  if have shasum; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif have sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  else
    err "no sha256 utility (shasum or sha256sum) available"
  fi
}

# Echo the SHA256 of <repo> <version> <asset-filename> from setup.shasums.
# Empty output if no entry is registered.
lookup_shasum() {
  local repo="$1" version="$2" asset="$3"
  awk -v r="$repo" -v v="$version" -v a="$asset" '
    $1 == r && $2 == v && $3 == a { print $4; exit }
  ' "$SHASUMS_FILE"
}

fetch_optional() {
  curl -fsSL -o "$2" "$1" 2>/dev/null && return 0
  rm -f "$2"
  return 1
}

# Best-effort Sigstore keyless signature verification for a release asset.
#
# Quietly skips when:
#   - `cosign` is not on PATH, or
#   - the upstream release does not publish a `.sigstore` bundle or
#     matching `.sig`/`.pem` detached files for this asset.
#
# When a signature is found, the asset's bytes are checked against the
# transparency-log-issued certificate; identity must match a workflow in
# the same `${repo}` and the issuer must be GitHub Actions' OIDC. A
# failed verification stops the script with an error.
maybe_cosign_verify() {
  local repo="$1" version="$2" asset_name="$3" asset_path="$4" tmpdir="$5"
  if ! have cosign; then
    log "cosign not on PATH; skipping signature verification for ${asset_name}"
    return
  fi

  local base="https://github.com/${repo}/releases/download/${version}"
  local bundle_path="${tmpdir}/${asset_name}.sigstore"
  local sig_path="${tmpdir}/${asset_name}.sig"
  local cert_path="${tmpdir}/${asset_name}.pem"
  local identity_re="^https://github.com/${repo}/"
  local issuer="https://token.actions.githubusercontent.com"

  if fetch_optional "${base}/${asset_name}.sigstore" "${bundle_path}"; then
    log "verifying sigstore bundle for ${asset_name}"
    cosign verify-blob \
      --bundle "${bundle_path}" \
      --certificate-identity-regexp "${identity_re}" \
      --certificate-oidc-issuer "${issuer}" \
      "${asset_path}" \
      || err "cosign signature verification failed for ${asset_name}"
    log "sigstore signature verified for ${asset_name}"
    return
  fi

  if fetch_optional "${base}/${asset_name}.sig" "${sig_path}" \
       && fetch_optional "${base}/${asset_name}.pem" "${cert_path}"; then
    log "verifying detached cosign signature for ${asset_name}"
    cosign verify-blob \
      --signature "${sig_path}" \
      --certificate "${cert_path}" \
      --certificate-identity-regexp "${identity_re}" \
      --certificate-oidc-issuer "${issuer}" \
      "${asset_path}" \
      || err "cosign signature verification failed for ${asset_name}"
    log "detached cosign signature verified for ${asset_name}"
    return
  fi

  log "no sigstore signature published for ${asset_name}; skipping (sha256 already verified)"
}

# Download a single asset from a GitHub release, SHA256-verify it against
# bin/setup.shasums, then install the contained binary to ~/.local/bin.
#
# Args:
#   $1 repo (owner/name)
#   $2 binary name (also used to locate it inside an extracted archive)
#   $3 exact asset filename within the release
#   $4 release tag (e.g. "v1.2.3")
#
# Supported asset shapes: `.tar.gz`, `.tar.xz`, `.gz`-compressed single
# binary, and uncompressed single binary.
install_github_release_asset() {
  local repo="$1" binary_name="$2" asset_name="$3" version="$4"
  local bindir tmpdir tmpasset asset_url expected_sha256 actual_sha256 binary

  bindir="${HOME}/.local/bin"
  mkdir -p "$bindir"

  expected_sha256="$(lookup_shasum "$repo" "$version" "$asset_name")"
  [ -n "$expected_sha256" ] || err "no SHA256 entry in ${SHASUMS_FILE} for ${repo} ${version} ${asset_name}"

  tmpdir="$(mktemp -d)"
  tmpasset="${tmpdir}/${asset_name}"
  asset_url="https://github.com/${repo}/releases/download/${version}/${asset_name}"

  log "downloading ${asset_url}"
  curl -fsSL -o "${tmpasset}" "${asset_url}"

  actual_sha256="$(sha256_of "${tmpasset}")"
  if [ "$actual_sha256" != "$expected_sha256" ]; then
    rm -rf "$tmpdir"
    err "sha256 mismatch for ${asset_name}: expected ${expected_sha256}, got ${actual_sha256}"
  fi
  log "sha256 verified for ${asset_name}"

  maybe_cosign_verify "$repo" "$version" "$asset_name" "$tmpasset" "$tmpdir"

  case "$asset_name" in
    *.tar.gz|*.tar.xz)
      tar -xf "${tmpasset}" -C "$tmpdir"
      binary="$(find "$tmpdir" -type f -name "$binary_name" -perm -u+x | head -1)"
      ;;
    *.gz)
      gunzip "${tmpasset}"
      binary="${tmpasset%.gz}"
      ;;
    *)
      binary="${tmpasset}"
      ;;
  esac

  if [ -z "$binary" ] || [ ! -f "$binary" ]; then
    rm -rf "$tmpdir"
    err "${binary_name} binary not found after extracting ${asset_name}"
  fi

  install -m 0755 "$binary" "${bindir}/${binary_name}"
  rm -rf "$tmpdir"
  log "installed ${binary_name} ${version} to ${bindir}/${binary_name}"

  case ":$PATH:" in
    *":$bindir:"*) : ;;
    *) log "note: add $bindir to PATH to use ${binary_name}" ;;
  esac
}

install_lefthook() {
  if have lefthook; then
    log "lefthook already installed"
    return
  fi
  local os arch
  case "$(uname -s)" in
    Darwin) os="MacOS" ;;
    Linux)  os="Linux" ;;
    *)      err "unsupported OS for lefthook binary: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="x86_64" ;;
    arm64|aarch64) arch="arm64" ;;
    *)             err "unsupported arch for lefthook binary: $(uname -m)" ;;
  esac
  install_github_release_asset evilmartians/lefthook lefthook \
    "lefthook_${LEFTHOOK_VERSION#v}_${os}_${arch}" "${LEFTHOOK_VERSION}"
}

install_actionlint() {
  if have actionlint; then
    log "actionlint already installed"
    return
  fi
  local os arch
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux)  os="linux" ;;
    *)      err "unsupported OS for actionlint binary: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="amd64" ;;
    arm64|aarch64) arch="arm64" ;;
    *)             err "unsupported arch for actionlint binary: $(uname -m)" ;;
  esac
  install_github_release_asset rhysd/actionlint actionlint \
    "actionlint_${ACTIONLINT_VERSION#v}_${os}_${arch}.tar.gz" "${ACTIONLINT_VERSION}"
}

install_gitleaks() {
  if have gitleaks; then
    log "gitleaks already installed"
    return
  fi
  local os arch
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux)  os="linux" ;;
    *)      err "unsupported OS for gitleaks binary: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="x64" ;;
    arm64|aarch64) arch="arm64" ;;
    *)             err "unsupported arch for gitleaks binary: $(uname -m)" ;;
  esac
  install_github_release_asset gitleaks/gitleaks gitleaks \
    "gitleaks_${GITLEAKS_VERSION#v}_${os}_${arch}.tar.gz" "${GITLEAKS_VERSION}"
}

install_shellcheck() {
  if have shellcheck; then
    log "shellcheck already installed"
    return
  fi
  local os arch
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux)  os="linux" ;;
    *)      err "unsupported OS for shellcheck binary: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="x86_64" ;;
    arm64|aarch64) arch="aarch64" ;;
    *)             err "unsupported arch for shellcheck binary: $(uname -m)" ;;
  esac
  install_github_release_asset koalaman/shellcheck shellcheck \
    "shellcheck-${SHELLCHECK_VERSION}.${os}.${arch}.tar.xz" "${SHELLCHECK_VERSION}"
}

install_committed() {
  if have committed; then
    log "committed already installed"
    return
  fi
  local os arch
  case "$(uname -s)" in
    Darwin) os="apple-darwin" ;;
    Linux)  os="unknown-linux-musl" ;;
    *)      err "unsupported OS for committed binary: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="x86_64" ;;
    arm64|aarch64) arch="aarch64" ;;
    *)             err "unsupported arch for committed binary: $(uname -m)" ;;
  esac
  install_github_release_asset crate-ci/committed committed \
    "committed-${COMMITTED_VERSION}-${arch}-${os}.tar.gz" "${COMMITTED_VERSION}"
}

install_mado() {
  if have mado; then
    log "mado already installed"
    return
  fi
  local os arch
  case "$(uname -s)" in
    Darwin) os="macOS" ;;
    Linux)  os="Linux-gnu" ;;
    *)      err "unsupported OS for mado binary: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="x86_64" ;;
    arm64|aarch64) arch="arm64" ;;
    *)             err "unsupported arch for mado binary: $(uname -m)" ;;
  esac
  install_github_release_asset akiomik/mado mado \
    "mado-${os}-${arch}.tar.gz" "${MADO_VERSION}"
}

install_check_jsonschema() {
  if have check-jsonschema; then
    log "check-jsonschema already installed"
    return
  fi
  if ! have brew; then
    err "check-jsonschema not found and Homebrew unavailable. Install Homebrew (https://brew.sh) and re-run, or install check-jsonschema yourself."
  fi
  log "installing check-jsonschema via Homebrew"
  brew install check-jsonschema
}

main() {
  cd "$REPO_ROOT"

  install_lefthook
  install_actionlint
  install_gitleaks
  install_shellcheck
  install_mado
  install_committed
  install_check_jsonschema

  log "wiring git hooks"
  lefthook install

  log "done"
}

main "$@"
